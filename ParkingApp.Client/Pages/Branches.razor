@page "/branches"
@attribute [Authorize(Roles = "Owner")]
@using Microsoft.AspNetCore.Authorization
@using ParkingApp.Client.Consumers.Branches
@using ParkingApp.Client.ViewModels
@inject IBranchesConsumer BranchesConsumer

<PageTitle>Υποκαταστήματα · ParkingApp</PageTitle>

<div class="page-header">
    <MudText Typo="Typo.h4" HtmlTag="h1">Υποκαταστήματα</MudText>
    <span class="page-subtitle">Τα parking της εταιρίας σας. Ανοίξτε ένα για να ορίσετε ορόφους και θέσεις.</span>
</div>

@if (_viewModel is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <div class="branches-layout">
        @* Create form (always visible) *@
        <MudPaper Outlined="true" Class="section-card">
            <MudText Typo="Typo.h6" HtmlTag="h2">Νέο υποκατάστημα</MudText>
            <div class="form-row">
                <MudTextField @bind-Value="_viewModel.NewBranchName"
                              Label="Όνομα"
                              Placeholder="π.χ. Athens Center"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              Disabled="@_viewModel.IsCreating"
                              Class="grow" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="_viewModel.CreateAsync"
                           Disabled="@_viewModel.IsCreating">
                    @(_viewModel.IsCreating ? "Προσθήκη..." : "Προσθήκη")
                </MudButton>
            </div>
            @if (!string.IsNullOrEmpty(_viewModel.CreateError))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_viewModel.CreateError</MudAlert>
            }
        </MudPaper>

        @* List *@
        @if (_viewModel.IsLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (!string.IsNullOrEmpty(_viewModel.LoadError))
        {
            <MudAlert Severity="Severity.Error">@_viewModel.LoadError</MudAlert>
        }
        else if (_viewModel.Branches.Count == 0)
        {
            <p class="muted">Δεν υπάρχουν υποκαταστήματα ακόμα. Προσθέστε το πρώτο από πάνω.</p>
        }
        else
        {
            <MudPaper Outlined="true" Class="list-card">
                @foreach (var branch in _viewModel.Branches)
                {
                    <a class="list-row" href="@($"branches/{branch.Id}")">
                        <MudIcon Icon="@Icons.Material.Outlined.Apartment" Color="Color.Secondary" />
                        <span class="list-row-title">@branch.Name</span>
                        <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Color="Color.Secondary" />
                    </a>
                }
            </MudPaper>
        }
    </div>
}

@code {
    private BranchesViewModel? _viewModel;

    protected override async Task OnInitializedAsync()
    {
        _viewModel = new BranchesViewModel(BranchesConsumer);
        await _viewModel.InitializeAsync();
    }
}