@page "/login"
@layout EmptyLayout
@using ParkingApp.Client.Services.Auth
@using ParkingApp.Shared.Auth
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Σύνδεση · ParkingApp</PageTitle>

<div class="login-page">
    <div class="login-panel">
        <div class="login-header">
            <span class="login-mark" aria-hidden="true">P</span>
            <MudText Typo="Typo.h4" HtmlTag="h1">Σύνδεση στο ParkingApp</MudText>
        </div>

        <MudPaper Outlined="true" Class="login-card">
            <EditForm Model="@_model" OnValidSubmit="HandleLogin">
                <MudStack Spacing="4">
                    <MudTextField @bind-Value="_model.UserName"
                                  Label="Όνομα χρήστη"
                                  Variant="Variant.Outlined"
                                  HelperText="Υπάλληλοι: κωδικός εταιρίας και όνομα, π.χ. athens.nikos"
                                  AutoFocus="true" />

                    <MudTextField @bind-Value="_model.Password"
                                  Label="Κωδικός"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password" />

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Text">@_error</MudAlert>
                    }

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               FullWidth="true"
                               Disabled="@_isSubmitting">
                        @(_isSubmitting ? "Σύνδεση..." : "Σύνδεση")
                    </MudButton>
                </MudStack>
            </EditForm>
        </MudPaper>
    </div>
</div>

@code {
    /// <summary>The form's data, bound to the input fields.</summary>
    private readonly LoginRequest _model = new() { UserName = "", Password = "" };

    /// <summary>Error message shown when login fails.</summary>
    private string? _error;

    /// <summary>True while the login request is in flight (disables the button).</summary>
    private bool _isSubmitting;

    /// <summary>
    /// Called when the form is submitted with valid input. Attempts login and either
    /// navigates home on success or shows the error message on failure.
    /// </summary>
    private async Task HandleLogin()
    {
        _isSubmitting = true;
        _error = null;

        try
        {
            var (success, _) = await AuthService.LoginAsync(_model);

            if (!success)
            {
                // Wrong credentials: show the message in the UI language; the user can simply try again
                _error = "Λάθος όνομα χρήστη ή κωδικός. Ελέγξτε τα στοιχεία και δοκιμάστε ξανά.";
                return;
            }

            // Read the freshly-stored token to decide where this user lands.
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();

            if (authState.User.IsInRole("Employee"))
            {
                Navigation.NavigateTo("console");
            }
            else
            {
                Navigation.NavigateTo("");
            }
        }
        catch
        {
            // The API could not be reached (not running, network down): no envelope came back
            _error = "Δεν υπάρχει σύνδεση με τον server. Δοκιμάστε ξανά σε λίγο.";
        }
        finally
        {
            // Runs on every exit path, so the button is never left disabled
            _isSubmitting = false;
        }
    }
}
