@page "/login"
@layout EmptyLayout
@using ParkingApp.Client.Services.Auth
@using ParkingApp.Shared.Auth
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-header">
            <h1>ParkingApp</h1>
            <p>Sign in to your account</p>
        </div>

        <EditForm Model="@_model" OnValidSubmit="HandleLogin" class="login-form">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="username">Username</label>
                <InputText id="username" class="form-input" @bind-Value="_model.UserName"
                           placeholder="you@example.com" />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <InputText id="password" type="password" class="form-input"
                           @bind-Value="_model.Password" placeholder="••••••••" />
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="login-error" role="alert">@_error</div>
            }

            <button type="submit" class="login-button" disabled="@_isSubmitting">
                @(_isSubmitting ? "Signing in..." : "Sign in")
            </button>
        </EditForm>
    </div>
</div>

@code {
    /// <summary>The form's data, bound to the input fields.</summary>
    private readonly LoginRequest _model = new() { UserName = "", Password = "" };

    /// <summary>Error message shown when login fails.</summary>
    private string? _error;

    /// <summary>True while the login request is in flight (disables the button).</summary>
    private bool _isSubmitting;

    /// <summary>
    /// Called when the form is submitted with valid input. Attempts login and either
    /// navigates home on success or shows the error message on failure.
    /// </summary>
    private async Task HandleLogin()
    {
        _isSubmitting = true;
        _error = null;

        try
        {
            var (success, error) = await AuthService.LoginAsync(_model);

            if (!success)
            {
                // Show the server's message (e.g. wrong credentials) — the user can simply try again
                _error = error;
                return;
            }

            // Read the freshly-stored token to decide where this user lands.
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();

            if (authState.User.IsInRole("Employee"))
            {
                Navigation.NavigateTo("console");
            }
            else
            {
                Navigation.NavigateTo("");
            }
        }
        catch
        {
            // The API could not be reached (not running, network down): no envelope came back
            _error = "Could not reach the server.";
        }
        finally
        {
            // Runs on every exit path, so the button is never left disabled
            _isSubmitting = false;
        }
    }
}