@page "/console"
@attribute [Authorize(Roles = "Employee")]
@using ParkingApp.Client.Services.Auth
@using ParkingApp.Client.Services.Session
@using ParkingApp.Client.ViewModels
@using ParkingApp.Client.Consumers.Console
@inject ISessionService SessionService
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IConsoleConsumer ConsoleConsumer

<div class="console-page">
    <h1>Parking console</h1>

    @if (_viewModel is null || _viewModel.IsLoading)
    {
        <p class="muted">Loading...</p>
    }
    else if (!string.IsNullOrEmpty(_viewModel.Error))
    {
        <p class="error" role="alert">@_viewModel.Error</p>
    }
    else if (_viewModel.ShowBranchPicker)
    {
        <BranchPickerModal Branches="_viewModel.Branches"
                           IsSelecting="_viewModel.IsSelecting"
                           OnSelect="_viewModel.SelectBranchAsync"
                           OnLogout="_viewModel.LogoutAsync" />
    }
    else
    {
        @* Ready: branch selected. The view model owns the data; the cards only display it. *@
        <OccupancyCards Items="_viewModel.Occupancy"
                        TotalSpots="_viewModel.TotalSpots"
                        OccupiedSpots="_viewModel.OccupiedSpots"
                        FreeSpots="_viewModel.FreeSpots"
                        IsLoading="_viewModel.IsLoadingOccupancy"
                        Error="@_viewModel.OccupancyError"
                        OnRefresh="_viewModel.LoadOccupancyAsync" />
    }
</div>

@code {
    private ConsoleViewModel? _viewModel;

    protected override async Task OnInitializedAsync()
    {
        _viewModel = new ConsoleViewModel(
            SessionService, ConsoleConsumer, AuthService, AuthStateProvider, Navigation);
        await _viewModel.InitializeAsync();
    }
}