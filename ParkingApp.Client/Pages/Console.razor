@page "/console"
@attribute [Authorize(Roles = "Employee")]
@using ParkingApp.Client.Services.Auth
@using ParkingApp.Client.Services.Session
@using ParkingApp.Client.ViewModels
@using ParkingApp.Client.Consumers.Console
@using ParkingApp.Client.Consumers.Tickets
@inject ISessionService SessionService
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IConsoleConsumer ConsoleConsumer
@inject ITicketsConsumer TicketsConsumer

<PageTitle>Ταμείο · ParkingApp</PageTitle>

<div class="console-page">
    @* The branch name is already in the top bar; the heading is for screen readers and focus *@
    <h1 class="visually-hidden">Ταμείο</h1>

    @if (_viewModel is null || _viewModel.IsLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (!string.IsNullOrEmpty(_viewModel.Error))
    {
        <MudAlert Severity="Severity.Error">@_viewModel.Error</MudAlert>
    }
    else if (_viewModel.ShowBranchPicker)
    {
        <BranchPickerModal Branches="_viewModel.Branches"
                           IsSelecting="_viewModel.IsSelecting"
                           OnSelect="_viewModel.SelectBranchAsync"
                           OnLogout="_viewModel.LogoutAsync" />
    }
    else
    {
        @* Ready: branch selected. The view model owns the data; the panels only display it. *@
        @* One refresh reloads BOTH panels, and stays disabled until both are done — they must never disagree *@
        <OccupancyCards Items="_viewModel.Occupancy"
                        TotalSpots="_viewModel.TotalSpots"
                        OccupiedSpots="_viewModel.OccupiedSpots"
                        FreeSpots="_viewModel.FreeSpots"
                        IsLoading="_viewModel.IsLoadingOccupancy || _viewModel.IsLoadingSpotMap"
                        Error="@_viewModel.OccupancyError"
                        OnRefresh="_viewModel.RefreshAsync" />

        @* Entry and exit side by side; both work with the map below through the view model *@
        <div class="console-actions">
            <EntryPanel SelectedVehicleSize="_viewModel.SelectedVehicleSize"
                        OnSelectVehicleSize="_viewModel.SelectVehicleSizeAsync"
                        SelectedPlateKind="_viewModel.SelectedPlateKind"
                        OnSelectPlateKind="_viewModel.SetPlateKind"
                        Plate="@_viewModel.PlateInput"
                        OnPlateChanged="_viewModel.SetPlateInput"
                        PlatePreview="@_viewModel.PlatePreview"
                        PlateError="@_viewModel.PlateError"
                        SelectedSpot="_viewModel.SelectedSpot"
                        IsSuggested="_viewModel.IsSelectedSpotSuggested"
                        HasAnyPackages="_viewModel.Packages.Count > 0"
                        Packages="_viewModel.AvailablePackages"
                        SelectedPackageId="_viewModel.EffectivePackageId"
                        OnSelectPackage="_viewModel.SelectPackage"
                        CanSubmit="_viewModel.CanSubmitEntry"
                        IsSubmitting="_viewModel.IsSubmittingEntry"
                        IsLoading="_viewModel.IsLoadingSpotMap"
                        Error="@_viewModel.EntryError"
                        LastTicket="_viewModel.LastTicket"
                        OnSubmit="_viewModel.SubmitEntryAsync" />

            <ExitPanel SearchText="@_viewModel.ExitSearchText"
                       OnSearchChanged="_viewModel.SetExitSearch"
                       Results="_viewModel.ExitSearchResults"
                       OnSelectTicket="_viewModel.SelectTicketAsync"
                       Quote="_viewModel.ExitQuote"
                       IsLoadingQuote="_viewModel.IsLoadingQuote"
                       SelectedOptionIndex="_viewModel.SelectedOptionIndex"
                       SelectedOption="_viewModel.SelectedOption"
                       OnSelectOption="_viewModel.SelectOption"
                       IsConfirming="_viewModel.IsConfirmingExit"
                       IsExiting="_viewModel.IsExiting"
                       Error="@_viewModel.ExitError"
                       LastExit="_viewModel.LastExit"
                       OnRequestExit="_viewModel.RequestExit"
                       OnCancelExit="_viewModel.CancelExit"
                       OnConfirmExit="_viewModel.ConfirmExitAsync"
                       OnRefreshQuote="_viewModel.RefreshQuoteAsync"
                       OnClose="_viewModel.CloseTicket" />
        </div>

        <SpotMapPanel Map="_viewModel.SpotMap"
                      SelectedFloor="_viewModel.SelectedFloor"
                      SelectedVehicleSize="_viewModel.SelectedVehicleSize"
                      SelectedSpotId="_viewModel.SelectedSpotId"
                      FocusedSpotId="_viewModel.FocusedSpotId"
                      IsLoading="_viewModel.IsLoadingSpotMap"
                      Error="@_viewModel.SpotMapError"
                      OnSelectSpot="_viewModel.SelectSpot"
                      OnSelectOccupied="_viewModel.SelectOccupiedSpotAsync"
                      OnSelectFloor="_viewModel.SelectFloor" />
    }
</div>

@code {
    private ConsoleViewModel? _viewModel;

    protected override async Task OnInitializedAsync()
    {
        _viewModel = new ConsoleViewModel(
            SessionService, ConsoleConsumer, TicketsConsumer, AuthService, AuthStateProvider, Navigation);
        await _viewModel.InitializeAsync();
    }
}