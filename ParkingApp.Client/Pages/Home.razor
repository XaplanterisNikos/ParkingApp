@page "/"
@attribute [Authorize(Roles = "Owner")]
@using Microsoft.AspNetCore.Authorization
@using ParkingApp.Client.Consumers.Companies
@using ParkingApp.Client.Services.Auth
@using ParkingApp.Client.ViewModels
@inject ICompaniesConsumer CompaniesConsumer
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Επισκόπηση · ParkingApp</PageTitle>

@if (_viewModel is null || _viewModel.IsLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_viewModel.Company is null)
{
    <MudAlert Severity="Severity.Error">@(_viewModel.Error ?? "Δεν ήταν δυνατή η φόρτωση της εταιρίας σας.")</MudAlert>
}
else
{
    <div class="page-header">
        <MudText Typo="Typo.h4" HtmlTag="h1">@_viewModel.Company.Name</MudText>
        <span class="page-subtitle">Από εδώ στήνετε τα υποκαταστήματα και τους υπαλλήλους σας.</span>
    </div>

    @* Two starting points; statistics will join them in a later slice *@
    <div class="home-links">
        <MudPaper Outlined="true" Class="section-card">
            <MudIcon Icon="@Icons.Material.Outlined.Apartment" Color="Color.Primary" />
            <MudText Typo="Typo.h6" HtmlTag="h2">Υποκαταστήματα</MudText>
            <span class="muted">Ορόφους και θέσεις για κάθε parking σας.</span>
            <div>
                <MudButton Href="branches" Variant="Variant.Outlined" Color="Color.Primary">Άνοιγμα</MudButton>
            </div>
        </MudPaper>

        <MudPaper Outlined="true" Class="section-card">
            <MudIcon Icon="@Icons.Material.Outlined.Group" Color="Color.Primary" />
            <MudText Typo="Typo.h6" HtmlTag="h2">Υπάλληλοι</MudText>
            <span class="muted">Λογαριασμοί για όσους δουλεύουν στα ταμεία.</span>
            <div>
                <MudButton Href="employees" Variant="Variant.Outlined" Color="Color.Primary">Άνοιγμα</MudButton>
            </div>
        </MudPaper>
    </div>
}

@code {
    private HomeViewModel? _viewModel;

    protected override async Task OnInitializedAsync()
    {
        _viewModel = new HomeViewModel(
            CompaniesConsumer, AuthService, AuthStateProvider, Navigation);
        await _viewModel.InitializeAsync();
    }

}
