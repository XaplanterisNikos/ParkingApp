@page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ParkingApp.Client.Consumers.Companies
@using ParkingApp.Client.Services.Auth
@using ParkingApp.Client.ViewModels
@inject ICompaniesConsumer CompaniesConsumer
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider


<h1>Welcome</h1>

@if (_viewModel is null || _viewModel.IsLoading)
{
    <p>Loading...</p>
}
else
{
    <AuthorizeView>
        <Authorized>
            @if (_viewModel.Company is not null)
            {
                <p>Signed in to <strong>@_viewModel.Company.Name</strong>.</p>
            }
            else
            {
                <p role="alert">@(_viewModel.Error ?? "Could not load your company.")</p>
            }

            <hr />

            <p>User: <strong>@_viewModel.UserName</strong></p>
            <p>Role: <strong>@_viewModel.Role</strong></p>

            <button @onclick="_viewModel.LogoutAsync">Sign out</button>
        </Authorized>
    </AuthorizeView>
}
@code {
    private HomeViewModel? _viewModel;

    protected override async Task OnInitializedAsync()
    {
        _viewModel = new HomeViewModel(
            CompaniesConsumer, AuthService, AuthStateProvider, Navigation);
        await _viewModel.InitializeAsync();
    }

}
