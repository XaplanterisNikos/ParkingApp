@page "/employees"
@attribute [Authorize(Roles = "Owner")]
@using Microsoft.AspNetCore.Authorization
@using ParkingApp.Client.Consumers.Branches
@using ParkingApp.Client.Consumers.Employees
@using ParkingApp.Client.ViewModels
@inject IEmployeesConsumer EmployeesConsumer
@inject IBranchesConsumer BranchesConsumer

<PageTitle>Υπάλληλοι · ParkingApp</PageTitle>

<div class="page-header">
    <MudText Typo="Typo.h4" HtmlTag="h1">Υπάλληλοι</MudText>
    <span class="page-subtitle">Λογαριασμοί για όσους δουλεύουν στα ταμεία των υποκαταστημάτων σας.</span>
</div>

@if (_viewModel is null || _viewModel.IsLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_viewModel.Branches.Count == 0)
{
    <MudPaper Outlined="true" Class="section-card" Style="max-width: 640px">
        <span>Χρειάζεστε τουλάχιστον ένα υποκατάστημα πριν προσθέσετε υπαλλήλους.</span>
        <div>
            <MudButton Href="branches" Variant="Variant.Filled" Color="Color.Primary">Δημιουργία υποκαταστήματος</MudButton>
        </div>
    </MudPaper>
}
else
{
    <div class="employees-layout">
        @* Create form *@
        <MudPaper Outlined="true" Class="section-card">
            <MudText Typo="Typo.h6" HtmlTag="h2">Νέος υπάλληλος</MudText>

            @* autocomplete="new-password" keeps the browser from filling in the owner's own login *@
            <div class="employee-fields">
                <MudTextField @bind-Value="_viewModel.NewUsername"
                              Label="Όνομα χρήστη"
                              HelperText="Ο κωδικός της εταιρίας μπαίνει μπροστά, π.χ. athens.giannis"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              Disabled="@_viewModel.IsCreating"
                              autocomplete="off" />
                <MudTextField @bind-Value="_viewModel.NewFullName"
                              Label="Ονοματεπώνυμο"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              Disabled="@_viewModel.IsCreating"
                              autocomplete="off" />
                <MudTextField @bind-Value="_viewModel.NewPassword"
                              Label="Κωδικός"
                              HelperText="Τουλάχιστον 6 χαρακτήρες, με κεφαλαίο, πεζό, αριθμό και σύμβολο"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Immediate="true"
                              Disabled="@_viewModel.IsCreating"
                              autocomplete="new-password" />
            </div>

            <div class="branch-choice">
                <span class="branch-choice-title">Υποκαταστήματα</span>
                <div class="branch-choice-list">
                    @foreach (var branch in _viewModel.Branches)
                    {
                        <MudCheckBox T="bool"
                                     Value="@_viewModel.SelectedBranchIds.Contains(branch.Id)"
                                     ValueChanged="_ => _viewModel.ToggleBranch(branch.Id)"
                                     Label="@branch.Name"
                                     Color="Color.Primary"
                                     Disabled="@_viewModel.IsCreating" />
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_viewModel.CreateError))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_viewModel.CreateError</MudAlert>
            }

            <div>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="_viewModel.CreateAsync"
                           Disabled="@_viewModel.IsCreating">
                    @(_viewModel.IsCreating ? "Προσθήκη..." : "Προσθήκη υπαλλήλου")
                </MudButton>
            </div>
        </MudPaper>

        @* List *@
        @if (!string.IsNullOrEmpty(_viewModel.LoadError))
        {
            <MudAlert Severity="Severity.Error">@_viewModel.LoadError</MudAlert>
        }
        else if (_viewModel.Employees.Count == 0)
        {
            <p class="muted">Δεν υπάρχουν υπάλληλοι ακόμα. Προσθέστε τον πρώτο από πάνω.</p>
        }
        else
        {
            <MudPaper Outlined="true" Class="table-card">
                <MudSimpleTable Hover="true" Elevation="0">
                    <thead>
                        <tr>
                            <th>Όνομα χρήστη</th>
                            <th>Ονοματεπώνυμο</th>
                            <th>Υποκαταστήματα</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in _viewModel.Employees)
                        {
                            <tr>
                                <td class="username">@employee.LoginUsername</td>
                                <td>@employee.FullName</td>
                                <td>
                                    @foreach (var branch in employee.Branches)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@branch.Name</MudChip>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        }
    </div>
}

@code {
    private EmployeesViewModel? _viewModel;

    protected override async Task OnInitializedAsync()
    {
        _viewModel = new EmployeesViewModel(EmployeesConsumer, BranchesConsumer);
        await _viewModel.InitializeAsync();
    }
}