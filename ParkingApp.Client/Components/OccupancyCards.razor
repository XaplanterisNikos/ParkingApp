@namespace ParkingApp.Client.Components
@using ParkingApp.Shared.Console
@using ParkingApp.Shared.Spots

@* Presentational: shows occupancy it is given; loading and refreshing belong to the page's view model. *@
<MudPaper Outlined="true" Class="occupancy-strip">
    @if (!string.IsNullOrEmpty(Error))
    {
        @* A failed load must not look like an empty branch *@
        <MudAlert Severity="Severity.Error" Dense="true" Class="occupancy-message">@Error</MudAlert>
    }
    else if (Items.Count == 0)
    {
        <span class="muted occupancy-message">Δεν υπάρχουν θέσεις σε αυτό το υποκατάστημα ακόμα.</span>
    }
    else
    {
        @* Branch-wide summary first, then one meter per size *@
        <div class="occupancy-total">
            <span class="occupancy-total-value">@FreeSpots</span>
            <span class="muted">ελεύθερες από @TotalSpots</span>
        </div>

        <div class="occupancy-sizes">
            @foreach (var item in Items)
            {
                // Free is derived here too — the DTO only carries Total and Occupied
                var free = item.Total - item.Occupied;
                var percent = item.Total == 0 ? 0 : 100.0 * free / item.Total;

                <div class="occupancy-size">
                    <div class="occupancy-size-line">
                        <span class="muted">@SpotSizeInfo.NameOf(item.Size)</span>
                        @if (free == 0)
                        {
                            <span class="occupancy-full">πλήρες</span>
                        }
                        else
                        {
                            <span class="tabular occupancy-count">@free / @item.Total</span>
                        }
                    </div>
                    <MudProgressLinear Value="percent" Color="Color.Success" Rounded="true" aria-hidden="true" />
                </div>
            }
        </div>
    }

    @* Refresh stays available even after an error *@
    <MudIconButton Icon="@Icons.Material.Outlined.Refresh"
                   Variant="Variant.Outlined"
                   aria-label="Ανανέωση"
                   title="Ανανέωση"
                   Disabled="@IsLoading"
                   OnClick="OnRefresh"
                   Class="occupancy-refresh" />
</MudPaper>

@code {
    /// <summary>Occupancy per spot size category (only sizes that exist in the branch).</summary>
    [Parameter, EditorRequired] public List<SpotSizeOccupancyDto> Items { get; set; } = new();

    /// <summary>All spots in the branch.</summary>
    [Parameter] public int TotalSpots { get; set; }

    /// <summary>Spots with an active ticket.</summary>
    [Parameter] public int OccupiedSpots { get; set; }

    /// <summary>Spots available right now.</summary>
    [Parameter] public int FreeSpots { get; set; }

    /// <summary>True while occupancy is reloading (disables the refresh button).</summary>
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>Raised when the employee asks for fresh numbers.</summary>
    [Parameter] public EventCallback OnRefresh { get; set; }

    /// <summary>Error from the last load, shown instead of the cards (refresh stays available).</summary>
    [Parameter] public string? Error { get; set; }
}