@namespace ParkingApp.Client.Components
@using ParkingApp.Shared.Console
@using ParkingApp.Shared.Floors
@using ParkingApp.Shared.Spots

@* Presentational: shows the spot map it is given; loading, suggestion, selection and floor rules
   belong to the view model. The vehicle size is chosen in the entry panel. *@
<MudPaper Outlined="true" Class="section-card spot-map">
    @* Thin bar while reloading; the old map stays visible underneath *@
    @if (IsLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }

    @if (!string.IsNullOrEmpty(Error))
    {
        @* A failed load must not look like an empty branch *@
        <MudAlert Severity="Severity.Error">@Error</MudAlert>
    }
    else if (Map.Floors.Count == 0)
    {
        <p class="muted">Δεν υπάρχουν όροφοι σε αυτό το υποκατάστημα ακόμα.</p>
    }
    else
    {
        @if (SelectedVehicleSize is { } requestedSize && Map.SuggestedSpotId is null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" role="status">
                Δεν υπάρχει ελεύθερη θέση για @SpotSizeInfo.NameOf(requestedSize). Μπορεί να χρησιμοποιηθεί μεγαλύτερη ελεύθερη θέση.
            </MudAlert>
        }

        <div class="spot-map-body">
            @* Floors in building order: the highest at the top, basements at the bottom *@
            <nav class="floor-list spot-map-floors" aria-label="Όροφοι">
                @foreach (var floor in Map.Floors.OrderByDescending(floor => (int)floor.Type))
                {
                    var free = floor.Spots.Count(spot => !spot.IsOccupied);
                    var percent = floor.Spots.Count == 0 ? 0 : 100.0 * free / floor.Spots.Count;

                    <FloorButton Type="floor.Type"
                                 Selected="floor.Type == SelectedFloor?.Type"
                                 Detail="@($"{free} ελεύθερες")"
                                 Highlight="floor.Spots.Any(spot => spot.Id == Map.SuggestedSpotId)"
                                 HighlightTitle="Εδώ είναι η προτεινόμενη θέση"
                                 OnClick="() => OnSelectFloor.InvokeAsync(floor.Type)">
                        @* A button may only hold inline content, so the bar is made of spans *@
                        <span class="meter" aria-hidden="true"><span class="meter-fill" style="width: @(percent.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
                    </FloorButton>
                }
            </nav>

            <div class="spot-map-floor">
                @if (SelectedFloor is null || SelectedFloor.Spots.Count == 0)
                {
                    <p class="muted">Δεν υπάρχουν θέσεις σε αυτόν τον όροφο ακόμα.</p>
                }
                else
                {
                    <div class="spot-map-floor-header">
                        <MudText Typo="Typo.h5" HtmlTag="h2">@FloorTypeInfo.NameOf(SelectedFloor.Type)</MudText>

                        @* The legend says in words what the bays show *@
                        <div class="bay-legend" aria-hidden="true">
                            <span><span class="legend-swatch legend-free"></span>Ελεύθερη</span>
                            <span><span class="legend-swatch legend-occupied"></span>Πιασμένη</span>
                            <span><span class="legend-swatch legend-selected"></span>Επιλεγμένη</span>
                            <span><MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" />Προτεινόμενη</span>
                        </div>
                    </div>

                    @* One row per size; the server's order (size, then number) survives GroupBy *@
                    @foreach (var sizeGroup in SelectedFloor.Spots.GroupBy(spot => spot.Size))
                    {
                        <div class="bay-group">
                            <span class="bay-group-title">@SpotSizeInfo.NameOf(sizeGroup.Key)</span>
                            <div class="bay-row">
                                @foreach (var spot in sizeGroup)
                                {
                                    if (CanSelect(spot))
                                    {
                                        @* A free spot that fits the vehicle: a real button, reachable with the keyboard *@
                                        <button type="button"
                                                class="@BayCss(spot)"
                                                title="@BayTitle(spot)"
                                                aria-pressed="@(spot.Id == SelectedSpotId ? "true" : "false")"
                                                @onclick="() => OnSelectSpot.InvokeAsync(spot.Id)">
                                            @BayContent(spot)
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="@BayCss(spot)" title="@BayTitle(spot)">@BayContent(spot)</span>
                                    }
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</MudPaper>

@code {
    /// <summary>The active branch's spot map (floors in physical order, spots in display order).</summary>
    [Parameter, EditorRequired] public SpotMapDto Map { get; set; } = new();

    /// <summary>The floor currently shown, or null when the branch has no floors.</summary>
    [Parameter] public FloorMapDto? SelectedFloor { get; set; }

    /// <summary>The declared vehicle size, or null before choosing one (no spot can be selected then).</summary>
    [Parameter] public SpotSize? SelectedVehicleSize { get; set; }

    /// <summary>The spot the ticket will be issued for, or null.</summary>
    [Parameter] public Guid? SelectedSpotId { get; set; }

    /// <summary>True while the map reloads (the old map stays visible).</summary>
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>Error from the last load, shown instead of the map.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>Raised when the employee picks a free spot that fits the vehicle.</summary>
    [Parameter] public EventCallback<Guid> OnSelectSpot { get; set; }

    /// <summary>Raised when the employee switches to another floor.</summary>
    [Parameter] public EventCallback<FloorType> OnSelectFloor { get; set; }

    /// <summary>
    /// Enum values are ordered by size (Motorcycle &lt; Car &lt; LargeCar), so "&lt;" means "does not fit".
    /// Visual hint only — the server enforces the rule when the entry is confirmed.
    /// </summary>
    private bool IsTooSmall(SpotStatusDto spot) =>
        SelectedVehicleSize is { } size && spot.Size < size;

    /// <summary>
    /// True when the spot can be picked: a size was declared, the spot is free and it is not too small.
    /// Visual rule only — the view model and the server check it again.
    /// </summary>
    private bool CanSelect(SpotStatusDto spot) =>
        SelectedVehicleSize is not null && !spot.IsOccupied && !IsTooSmall(spot);

    /// <summary>
    /// The inside of a bay: a star for the suggestion, a car for an occupied spot,
    /// a green lamp for a free spot that fits; then the spot code.
    /// </summary>
    private RenderFragment BayContent(SpotStatusDto spot) =>
        @<text>
            @if (spot.Id == Map.SuggestedSpotId)
            {
                <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" aria-hidden="true" />
            }
            else if (spot.IsOccupied)
            {
                <MudIcon Icon="@Icons.Material.Outlined.DirectionsCar" Size="Size.Small" aria-hidden="true" />
            }
            else if (!IsTooSmall(spot))
            {
                <span class="bay-lamp" aria-hidden="true"></span>
            }
            <span>@spot.Number</span>
        </text>;

    /// <summary>CSS classes of a bay: the selected spot first, then occupied, too small, or free.</summary>
    private string BayCss(SpotStatusDto spot)
    {
        if (spot.Id == SelectedSpotId) return "bay bay-selected";
        if (spot.IsOccupied) return "bay bay-occupied";
        if (IsTooSmall(spot)) return "bay bay-too-small";
        return "bay";
    }

    /// <summary>Tooltip with the same information as the colours, in words — colour is never the only cue.</summary>
    private string BayTitle(SpotStatusDto spot)
    {
        var status = spot.Id == SelectedSpotId ? "επιλεγμένη"
            : spot.Id == Map.SuggestedSpotId ? "προτεινόμενη"
            : spot.IsOccupied ? "πιασμένη"
            : IsTooSmall(spot) ? "μικρή για το όχημα"
            : "ελεύθερη";

        return $"{spot.Number} · {SpotSizeInfo.NameOf(spot.Size)} · {status}";
    }
}
