@namespace ParkingApp.Client.Components
@using ParkingApp.Shared.Session

@* Forced choice: no close button and no click-outside; the only way out is to sign out *@
<div class="modal-backdrop">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="picker-title">
        <div class="modal-header">
            <MudText Typo="Typo.h5" HtmlTag="h2" id="picker-title">Σε ποιο υποκατάστημα δουλεύετε;</MudText>
            <span class="muted">Η επιλογή ισχύει μέχρι να αποσυνδεθείτε.</span>
        </div>

        <div class="branch-list">
            @foreach (var branch in Branches)
            {
                <button type="button"
                        class="branch-option"
                        @onclick="() => OnSelect.InvokeAsync(branch.Id)"
                        disabled="@IsSelecting">
                    <MudIcon Icon="@Icons.Material.Outlined.Apartment" Color="Color.Secondary" aria-hidden="true" />
                    <span class="branch-option-name">@branch.Name</span>
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Color="Color.Secondary" aria-hidden="true" />
                </button>
            }
        </div>

        <MudButton Variant="Variant.Text" OnClick="OnLogout" Disabled="@IsSelecting" Class="modal-logout">
            Αποσύνδεση
        </MudButton>
    </div>
</div>

@code {
    /// <summary>The branches the employee may choose from.</summary>
    [Parameter, EditorRequired] public List<BranchOptionDto> Branches { get; set; } = new();

    /// <summary>True while a selection is being processed (disables the buttons).</summary>
    [Parameter] public bool IsSelecting { get; set; }

    /// <summary>Raised with the chosen branch id.</summary>
    [Parameter] public EventCallback<Guid> OnSelect { get; set; }

    /// <summary>Raised when the employee abandons the choice and signs out.</summary>
    [Parameter] public EventCallback OnLogout { get; set; }
}